{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Conch",
  "version": "0.5.1",
  "identifier": "app.conch.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Conch",
        "width": 1040,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "workers/*",
      "licenses/*"
    ],
    "macOS": {
      "infoPlist": "Info.plist",
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA5NDMzM0Q1MzFEN0JFMkQKUldRdHZ0Y3gxVE5EQ1U4YmxNY0xTUEJxUXdZbEkzeXhBRVdDYUdjV2JWN0FhczZ5MTRKbzN1bGkK",
      "endpoints": [
        "https://github.com/greerviau/conch/releases/latest/download/latest.json"
      ]
    }
  }
}
