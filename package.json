{
  "name": "conch",
  "version": "0.4.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs && vitest run",
    "tauri": "tauri",
    "bundle:local": "scripts/bundle-local.sh",
    "lint": "eslint src",
    "format:check": "prettier --check src",
    "test:ui": "vitest run",
    "icons": "node scripts/prepare-brand.mjs && tauri icon assets/icon.svg --output src-tauri/icons && tauri icon assets/icon.svg --output .runtime/brand-icon --png 1024 && tauri icon assets/logo.svg --output .runtime/brand-logo --png 512 && node scripts/export-brand.mjs",
    "icons:tray": "tauri icon assets/tray.svg --output .runtime/tray-icon --png 44 && cp .runtime/tray-icon/44x44.png src-tauri/icons/tray.png"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.9.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^10.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.2.0",
    "vitest": "^5.1.0"
  }
}
